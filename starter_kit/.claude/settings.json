{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(python3 -m unittest)",
      "Bash(python3 -m unittest -v)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command":
  "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run_tests.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
